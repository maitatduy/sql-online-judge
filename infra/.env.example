# Sao chép thành infra/.env rồi đổi giá trị. Script khởi tạo MySQL chỉ chạy khi volume rỗng:
# đổi mật khẩu MySQL sau lần chạy đầu thì xoá volume bằng "docker compose -f infra/docker-compose.dev.yml down -v".

# Mật khẩu root của MySQL dev, chỉ dùng để quản trị và chạy script khởi tạo.
MYSQL_ROOT_PASSWORD=change-me-root

# Cổng MySQL mở ra máy host (chỉ 127.0.0.1).
MYSQL_PORT=3306

# Mật khẩu của user sqljudge_auth, chỉ có quyền trên database sqljudge_auth.
MYSQL_AUTH_PASSWORD=change-me-auth

# Mật khẩu Redis (requirepass).
REDIS_PASSWORD=change-me-redis

# Cổng Redis mở ra máy host (chỉ 127.0.0.1).
REDIS_PORT=6379

# Cổng SMTP của Mailpit để service gửi email khi dev, không cần đăng nhập.
MAILPIT_SMTP_PORT=1025

# Cổng giao diện web của Mailpit để xem email đã bắt: http://localhost:8025
MAILPIT_UI_PORT=8025
