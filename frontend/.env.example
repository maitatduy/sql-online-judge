# URL của api-gateway. Để trống thì gọi cùng nguồn với frontend (dùng khi bật API giả).
NEXT_PUBLIC_API_URL=

# Đặt "enabled" để bật API giả bằng MSW khi chạy npm run dev. Không có tác dụng ở production.
NEXT_PUBLIC_API_MOCKING=enabled

# Đặt "true" để hiện nút đăng nhập GitHub và Google ở production. Chỉ bật khi backend OAuth đã có.
NEXT_PUBLIC_OAUTH_ENABLED=false
